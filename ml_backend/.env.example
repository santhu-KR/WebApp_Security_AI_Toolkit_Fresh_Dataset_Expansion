# Copy this file to ml_backend/.env and add your own Gemini API key.
GEMINI_API_KEY=put_your_api_key_here
# Default model for this project
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Replace with a long random secret for local authentication
APP_TOKEN_SECRET=replace_with_a_long_random_secret
